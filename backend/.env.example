# ================================================
# APP
# ================================================
APP_NAME=FaturaJa
APP_ENV=local
APP_KEY=base64:
APP_DEBUG=true
APP_URL=http://app.factura-ja.localhost
FRONTEND_URL="http://app.factura-ja.localhost"

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ================================================
# DATABASE (LANDLORD)
# ================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=faturaja_landlord
DB_USERNAME=root
DB_PASSWORD=

# ================================================
# DATABASE (TENANT - Configuração Padrão)
# ================================================
#  ADICIONADO: Usados quando tenant não especifica
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=root
TENANT_DB_PASSWORD=

# ============================================
# SHARED DATABASE ( ADICIONAR!)
# ============================================
DB_SHARED_CONNECTION=mysql
DB_SHARED_HOST=127.0.0.1
DB_SHARED_PORT=3306
DB_SHARED_DATABASE=faturaja_shared
DB_SHARED_USERNAME=root
DB_SHARED_PASSWORD=


# ================================================
# SESSIONS
# ================================================
SESSION_DRIVER=file
#SESSION_CONNECTION=tenant
SESSION_LIFETIME=900
SESSION_ENCRYPT=false

SESSION_PATH=/
SESSION_DOMAIN=.app.factura-ja.localhost
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ================================================
# CACHE & QUEUE
# ================================================
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ================================================
# FILESYSTEM
# ================================================
FILESYSTEM_DISK=local

# ================================================
# TENANT DETECTION (HÍBRIDO)
# ================================================
# Modos: 'header' | 'subdomain' | 'hybrid'
TENANT_DETECTION_MODE=hybrid

# Prioridade quando em modo híbrido: 'header' | 'subdomain'
TENANT_HYBRID_PRIORITY=header

# ================================================
# BROADCAST & REDIS
# ================================================
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ================================================
# MAIL (Gmail SMTP)
# ================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=isidromanuel1141@gmail.com
MAIL_PASSWORD=ddidtovwtngxriaj
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=isidromanuel1141@gmail.com
MAIL_FROM_NAME="FaturaJa"

ADMIN_URL=http://app.factura-ja.localhost/landlord
MAIL_ADMIN_EMAIL=isidromanuel1141@gmail.com

GOOGLE_CLIENT_ID=SEU_CLIENT_ID_AQUI
GOOGLE_CLIENT_SECRET=SEU_CLIENT_SECRET_AQUI
GOOGLE_REDIRECT_URI=http://app.factura-ja.localhost/api/landlord/auth/google/callback


# ================================================
# SANCTUM / AUTH
# ================================================
# Lista os IPs mais comuns — o cors.php aceita todos os IPs locais automaticamente
# FRONTEND
# ================================================
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="http://app.factura-ja.localhost"

# ================================================
# AGT - Assinatura RSA
# ================================================
AGT_RSA_PRIVATE_KEY_PATH="/home/isidro-manuel/Sistema_de_fatura-o_mult_tenancy/backend/storage/keys/agt_private.pem"
AGT_RSA_KEY_VERSION=1

# Certificado AGT (obtido após submissão da chave pública à AGT)
AGT_NUMERO_CERTIFICADO=AGT-CERT-XXXX
AGT_NOME_SOFTWARE=FaturaJa_v1.0



# IMPRESSORA USB - CONFIGURAÇÃO PARA XPRINTER XP-80T 
# Para Linux: caminho do dispositivo USB
# Para Windows: nome exato da impressora
IMPRESSORA_USB_PATH=/dev/usb/lp0
#IMPRESSORA_CUPS_QUEUE=Epson_TM-T88IV_Raw
IMPRESSORA_CUPS_QUEUE=POS-80_Raw

# ── Domínio / Nginx ──────────────────────────────
APP_DOMAIN=app.factura-ja.localhost
FRONTEND_SCHEME=http
FRONTEND_PORT=

SANCTUM_STATEFUL_DOMAINS=app.factura-ja.localhost,*.app.factura-ja.localhost
