{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/vendor/**": true,
    "**/storage/**": true,
    "**/.phpunit.cache/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/vendor": true,
    "**/storage": true,
    "**/*.lock": true
  },
  "typescript.tsserver.maxTsServerMemory": 512,
  "editor.formatOnSave": false
}
